---
import { site } from "../data/site";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = site.name,
  description = site.intro,
} = Astro.props;
const pageTitle = title === site.name ? `${site.name} — ${site.domain}` : `${title} — ${site.name}`;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title={`${site.name} RSS`} href="/rss.xml" />
    <title>{pageTitle}</title>
  </head>
  <body>
    <div class="page-shell">
      <header class="site-header">
        <a class="brand" href="/" aria-label={`${site.name} 首页`}>
          <span class="brand-mark">RL</span>
          <span class="brand-name">{site.name}</span>
        </a>
        <nav aria-label="主要导航">
          <a href="/blog/">文章</a>
          <a href="/about/">关于</a>
        </nav>
      </header>
      <main><slot /></main>
      <footer class="site-footer">
        <p>© {new Date().getFullYear()} {site.name}</p>
        <a href={`mailto:${site.email}`}>{site.email}</a>
      </footer>
    </div>
  </body>
</html>
