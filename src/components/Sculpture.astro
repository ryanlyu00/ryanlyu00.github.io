<div class="television">
  <div class="tv-stage">
    <img class="tv-image" src="/crt-television-front.png" alt="" width="1536" height="1024" decoding="async" />
    <div class="tv-screen" role="img" aria-label="Build">
      <span class="tv-word">BUILD</span>
      <canvas class="tv-static" aria-hidden="true"></canvas>
      <span class="tv-scanlines" aria-hidden="true"></span>
    </div>
  </div>
</div>

<script>
  const television = document.querySelector<HTMLElement>('.television');
  if (television) {
    const screen = television.querySelector<HTMLElement>('.tv-screen')!;
    const word = television.querySelector<HTMLElement>('.tv-word')!;
    const canvas = television.querySelector<HTMLCanvasElement>('.tv-static')!;
    const ctx = canvas.getContext('2d')!;
    const words = ['BUILD', 'EXPLORE', 'THINK', 'PLAY', 'RYAN LYU'];
    const reduced = matchMedia('(prefers-reduced-motion: reduce)');
    let index = 0;
    let active = true;
    let switching = false;
    let interval: number | undefined;
    let noiseFrame: number | undefined;
    let revealTimer: number | undefined;
    let finishTimer: number | undefined;

    // A small bitmap, enlarged by CSS, makes the interference look like analog snow.
    canvas.width = 160;
    canvas.height = 90;
    function paintStatic() {
      const pixels = ctx.createImageData(canvas.width, canvas.height);
      for (let i = 0; i < pixels.data.length; i += 4) {
        const shade = Math.random() * 255;
        pixels.data[i] = shade;
        pixels.data[i + 1] = shade;
        pixels.data[i + 2] = shade;
        pixels.data[i + 3] = 255;
      }
      ctx.putImageData(pixels, 0, 0);
      if (switching && !reduced.matches && !document.hidden) noiseFrame = requestAnimationFrame(paintStatic);
    }

    function finishSwitch() {
      screen.classList.remove('is-tuning');
      switching = false;
      if (noiseFrame) cancelAnimationFrame(noiseFrame);
      noiseFrame = undefined;
    }

    function nextWord() {
      if (switching) return;
      index = (index + 1) % words.length;
      word.classList.toggle('is-long', words[index].length > 5);
      if (reduced.matches) {
        word.textContent = words[index];
        screen.setAttribute('aria-label', words[index]);
        return;
      }
      switching = true;
      screen.classList.add('is-tuning');
      paintStatic();
      revealTimer = window.setTimeout(() => {
        word.textContent = words[index];
        screen.setAttribute('aria-label', words[index]);
      }, 300);
      finishTimer = window.setTimeout(finishSwitch, 540);
    }

    function updatePlayback() {
      if (interval) window.clearInterval(interval);
      interval = undefined;
      if (active && !document.hidden && !reduced.matches) interval = window.setInterval(nextWord, 3800);
      if (document.hidden && switching) {
        window.clearTimeout(revealTimer);
        window.clearTimeout(finishTimer);
        word.textContent = words[index];
        screen.setAttribute('aria-label', words[index]);
        finishSwitch();
      }
    }

    new IntersectionObserver(([entry]) => { active = entry.isIntersecting; updatePlayback(); }).observe(television);
    reduced.addEventListener('change', () => {
      if (reduced.matches && switching) {
        window.clearTimeout(revealTimer);
        window.clearTimeout(finishTimer);
        word.textContent = words[index];
        screen.setAttribute('aria-label', words[index]);
        finishSwitch();
      }
      updatePlayback();
    });
    document.addEventListener('visibilitychange', updatePlayback);
    updatePlayback();
  }
</script>
