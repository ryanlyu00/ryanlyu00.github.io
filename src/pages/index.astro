---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import PostList from "../components/PostList.astro";
import { site } from "../data/site";

const posts = (await getCollection("blog", ({ data }) => !data.draft))
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf())
  .slice(0, 3);
---

<BaseLayout>
  <section class="hero">
    <div class="hero-kicker"><span></span> RYANLYU.COM · 在线</div>
    <h1>你好，我是<br /><em>Ryan Lyu.</em></h1>
    <p class="hero-intro">{site.intro}</p>
    <div class="hero-actions">
      {site.links.map((link) => (
        <a href={link.href} target="_blank" rel="noreferrer">{link.label}<span aria-hidden="true">↗</span></a>
      ))}
      <a href={`mailto:${site.email}`}>邮件联系<span aria-hidden="true">↗</span></a>
    </div>
    <div class="hero-note" aria-hidden="true">BUILD<br />WRITE<br />THINK</div>
  </section>

  <section class="latest" aria-labelledby="latest-title">
    <div class="section-heading">
      <p>01 / 最近写作</p>
      <h2 id="latest-title">文章与手记</h2>
      <a href="/blog/">查看全部 <span aria-hidden="true">→</span></a>
    </div>
    <PostList posts={posts} />
  </section>

  <section class="about-strip" aria-labelledby="about-title">
    <p>02 / 关于</p>
    <div>
      <h2 id="about-title">保持好奇，<br />持续交付。</h2>
      <div>
        <p>{site.bio}</p>
        <a class="text-link" href="/about/">更多关于我 <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>
</BaseLayout>
