---
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../data/site";
---

<BaseLayout title="About" description={`About ${site.name}.`}>
  <section class="about-page">
    <header>
      <p>ABOUT / RYAN</p>
      <h1>Hello,<br />I'm Ryan.</h1>
    </header>
    <figure class="about-portrait">
      <img
        src="/ryan-avatar.png"
        alt="Pixel portrait of Ryan Lyu"
        width="900"
        height="900"
      />
    </figure>
    <div class="about-copy">
      <p class="lead">{site.bio}</p>
      <p>This site is my digital garden: a place for ideas in progress, project reflections, and learning notes. It will grow slowly. I am not chasing a daily publishing schedule—only keeping what feels worth remembering.</p>
      <div class="contact-block">
        <p>FIND ME</p>
        <div>
          {site.links.map((link) => <a href={link.href} target="_blank" rel="noreferrer">{link.label} ↗</a>)}
          <a href={`mailto:${site.email}`}>Email ↗</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
