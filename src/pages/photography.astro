---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Photography" description="A photography archive by Ryan Lyu.">
  <header class="page-heading collection-heading">
    <p>PHOTOGRAPHY / ARCHIVE</p>
    <h1>Frames worth keeping</h1>
    <div class="heading-rule"><span>00 SERIES</span></div>
  </header>
  <section class="empty-archive" aria-labelledby="photography-status">
    <p>ARCHIVE IN PROGRESS</p>
    <h2 id="photography-status">Photographs will appear here as I publish them.</h2>
  </section>
</BaseLayout>
